APP_ENV=development
BASE_URL=https://lab.aismallbizguru.com
LABBOX_SITE_HOST=lab.aismallbizguru.com
TZ=America/Indiana/Indianapolis

ADMIN_PASSWORD_HASH=replace-with-argon2id-or-bcrypt-hash
ADMIN_SESSION_SECRET=replace-with-random-session-secret
ADMIN_SESSION_MAX_AGE_SECONDS=86400

API_TOKEN_PEPPER=replace-with-random-token-pepper

SQLITE_PATH=/data/sqlite/labbox.db
APP_CONFIG_PATH=/config/apps.yaml

MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
MINIO_BUCKET=labbox-assets
MINIO_AUTO_INIT=true
STORAGE_HEALTH_ENABLED=true
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key
S3_REGION=us-east-1

R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=lab-aismallbizguru-backups
R2_ENDPOINT=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com

RESTIC_REPOSITORY=s3:https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com/lab-aismallbizguru-backups
RESTIC_PASSWORD=replace-with-restic-password

BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_SCRIPT=/app/scripts/backup_now.sh
BACKUP_SCHEDULE_TIME=03:30
BACKUP_INCLUDE_ENV=false
